  "recipes": [
    {
      "title": "JB's Crepes",
      "short": "Crepes",
      "category": "Breakfast",
      "yield": "Makes 15 crepes",
      "prep": "10 min + 1 hr rest",
      "cook": "25 min",
      "credit": "RecipeTin Eats  \u00b7  Photo: Midjourney",
      "source": "https://www.recipetineats.com/crepes/",
      "qr": "pkg:/images/mychannel/qr_recipe_2.png",
      "qrLabel": "Full recipe",
      "thumb": "pkg:/images/mychannel/recipe_crepes.jpg",
      "video": "",
      "ingredients": [
        {
          "group": "Batter",
          "items": [
            "1 2/3 cups plain flour, sifted",
            "3 tbsp caster sugar",
            "1/4 tsp salt",
            "3 large eggs",
            "2 cups full-fat milk",
            "1/3 cup water",
            "2 tbsp neutral oil"
          ]
        },
        {
          "group": "For the pan",
          "items": [
            "3 tbsp unsalted butter, cubed"
          ]
        }
      ],
      "steps": [
        {
          "title": "Mix the dry ingredients",
          "lines": [
            "Sift the flour into a large bowl.",
            "Whisk in the sugar and salt."
          ]
        },
        {
          "title": "Add the eggs",
          "lines": [
            "Make a well in the middle.",
            "Crack in the eggs.",
            "Stir in just enough flour to make a thick paste."
          ]
        },
        {
          "title": "Whisk in the liquids",
          "lines": [
            "Slowly whisk in the milk until smooth.",
            "Add the water and oil.",
            "Whisk until glossy and pourable."
          ]
        },
        {
          "title": "Rest the batter",
          "lines": [
            "Cover the bowl.",
            "Leave it at room temperature for about 1 hour."
          ]
        },
        {
          "title": "Heat the pan",
          "lines": [
            "Use a non-stick pan over medium-high heat.",
            "Turn it to medium if your stove runs hot."
          ]
        },
        {
          "title": "Grease it lightly",
          "lines": [
            "Melt a little butter in the pan.",
            "Wipe most of it out, leaving a thin film."
          ]
        },
        {
          "title": "Pour and swirl",
          "lines": [
            "Lift the pan off the heat.",
            "Pour in about 1/4 cup of batter.",
            "Swirl fast to coat the bottom thinly."
          ]
        },
        {
          "title": "Cook and flip",
          "lines": [
            "Cook 45 seconds to 1 minute until golden underneath.",
            "Flip it.",
            "Cook the other side about 30 seconds."
          ]
        },
        {
          "title": "Stack and serve",
          "lines": [
            "Slide it onto a plate.",
            "Add a little butter and repeat.",
            "Serve with your favorite toppings."
          ]
        }
      ],
      "description": "Thin, buttery French-style pancakes. Make the batter ahead, then cook them one by one and stack them up with your favorite toppings."
    },
    {
      "title": "Family Mac and Cheese",
      "short": "Mac and Cheese",
      "category": "Lunch",
      "yield": "Serves 6",
      "prep": "15 min",
      "cook": "30 min",
      "credit": "Family recipe (sample)  \u00b7  Photo: Midjourney",
      "source": "",
      "qr": "",
      "qrLabel": "",
      "thumb": "pkg:/images/mychannel/recipe_mac.jpg",
      "video": "",
      "ingredients": [
        {
          "group": "Pasta and sauce",
          "items": [
            "1 lb elbow macaroni",
            "4 tbsp butter",
            "1/4 cup flour",
            "3 cups whole milk",
            "1 tsp salt",
            "1/2 tsp black pepper",
            "1/2 tsp mustard powder"
          ]
        },
        {
          "group": "Cheese and topping",
          "items": [
            "3 cups sharp cheddar, shredded (divided)",
            "1 cup mozzarella, shredded",
            "1/2 cup breadcrumbs",
            "1 tbsp melted butter"
          ]
        }
      ],
      "steps": [
        {
          "title": "Get ready",
          "lines": [
            "Heat the oven to 375 F.",
            "Butter a 9 x 13 baking dish."
          ]
        },
        {
          "title": "Cook the pasta",
          "lines": [
            "Boil the macaroni 1 minute less than the package says.",
            "Drain it."
          ]
        },
        {
          "title": "Start the sauce",
          "lines": [
            "Melt the butter in a large pot.",
            "Whisk in the flour.",
            "Stir for 1 minute."
          ]
        },
        {
          "title": "Add the milk",
          "lines": [
            "Slowly whisk in the milk.",
            "Simmer about 5 minutes until thick."
          ]
        },
        {
          "title": "Melt in the cheese",
          "lines": [
            "Take the pot off the heat.",
            "Stir in the salt, pepper and mustard.",
            "Stir in 2 cups of cheddar and the mozzarella until smooth."
          ]
        },
        {
          "title": "Fill the dish",
          "lines": [
            "Fold in the pasta and pour it into the dish.",
            "Top with the rest of the cheddar.",
            "Toss the breadcrumbs with melted butter and sprinkle on top."
          ]
        },
        {
          "title": "Bake",
          "lines": [
            "Bake 25 to 30 minutes until bubbly and golden.",
            "Rest 5 minutes before serving."
          ]
        }
      ],
      "description": "A creamy, baked family classic made with sharp cheddar and mozzarella, folded into tender macaroni and finished with a crunchy golden breadcrumb top. This is a sample family recipe, so swap in one of your own and make it yours.",
      "people": [
        "Josephine"
      ]
    },
    {
      "title": "Beef Rice Noodles",
      "short": "Beef Rice Noodles",
      "category": "Lunch",
      "yield": "Serves 2-3",
      "prep": "10 min + 20 min to tenderize",
      "cook": "10 min",
      "credit": "RecipeTin Eats  \u00b7  Photo: Midjourney",
      "source": "https://www.recipetineats.com/beef-rice-noodles/",
      "qr": "pkg:/images/mychannel/qr_recipe_3.png",
      "qrLabel": "Full recipe",
      "video": "",
      "thumb": "pkg:/images/mychannel/recipe_noodles.jpg",
      "description": "A quick beef and rice noodle stir-fry in a savory, garlicky soy sauce. Tenderizing the beef first keeps it juicy.",
      "ingredients": [
        {
          "group": "Tenderized beef",
          "items": [
            "200 g (7 oz) rump or top sirloin, thinly sliced",
            "1/2 tsp baking soda (not baking powder)",
            "2 tsp light soy sauce"
          ]
        },
        {
          "group": "Stir fry",
          "items": [
            "2 tbsp peanut or neutral oil",
            "200 g (7 oz) flat rice noodles",
            "3 garlic cloves, minced",
            "1/2 onion, sliced",
            "6-8 baby bok choy, stems and leaves separated"
          ]
        },
        {
          "group": "Sauce",
          "items": [
            "1 tbsp light soy sauce",
            "1 1/2 tbsp dark soy sauce",
            "3 tbsp oyster sauce",
            "2 tsp white sugar",
            "1 tbsp water",
            "Pinch of white pepper"
          ]
        }
      ],
      "steps": [
        {
          "title": "Tenderize the beef",
          "lines": [
            "Sprinkle the beef with the baking soda.",
            "Toss to coat, separating the slices.",
            "Leave it for 20 minutes."
          ]
        },
        {
          "title": "Rinse and season",
          "lines": [
            "Rinse the beef in a colander.",
            "Pat off the extra water.",
            "Toss with the 2 tsp light soy sauce."
          ]
        },
        {
          "title": "Mix the sauce",
          "lines": [
            "Stir the sauce ingredients together in a small bowl."
          ]
        },
        {
          "title": "Prepare the noodles",
          "lines": [
            "Soak them as the packet says, usually 5 to 10 minutes.",
            "Drain, then rinse so they don't go gluey."
          ]
        },
        {
          "title": "Cook onion, beef, then garlic",
          "lines": [
            "Heat the oil in a large wok over high heat.",
            "Add the onion for 30 seconds.",
            "Add the beef for about 1 minute.",
            "Add the garlic for 30 seconds."
          ]
        },
        {
          "title": "Add everything else",
          "lines": [
            "Add the green stems and toss for 1 minute.",
            "Add the leaves, then the noodles, then the sauce.",
            "Toss 1 1/2 to 2 minutes until the sauce coats the noodles.",
            "Serve right away."
          ]
        }
      ]
    },
    {
      "title": "Chinese-Style Braised Mackerel",
      "servings": "2",
      "prep": "15 min",
      "cook": "20-25 min",
      "credit": "Video: XiaosKitchen",
      "qr": "pkg:/images/mychannel/qr_recipe_1.png",
      "source": "https://pixabay.com/videos/cooking-mackerel-fish-food-healthy-11635/",
      "thumb": "http://YOUR_JELLYFIN_IP:8096/Items/2a5b4aec40db3660e294a0e1abb4f0f7/Images/Primary?maxWidth=1920&ApiKey=YOUR_JELLYFIN_API_KEY",
      "video": "http://YOUR_JELLYFIN_IP:8096/Videos/2a5b4aec40db3660e294a0e1abb4f0f7/stream.mp4?static=true&ApiKey=YOUR_JELLYFIN_API_KEY",
      "ingredients": [
        {
          "group": "Main & Aromatics",
          "items": [
            "2 whole fresh mackerel, cleaned and patted dry",
            "2 large tomatoes, diced",
            "2 spring onions, chopped (whites and greens separated)",
            "4 cloves garlic, minced",
            "1-inch piece fresh ginger, minced",
            "1 whole star anise",
            "2 tbsp neutral cooking oil"
          ]
        },
        {
          "group": "Sauce & Seasoning",
          "items": [
            "2 tbsp soy sauce",
            "2 tbsp tomato paste, divided",
            "1-2 tbsp Shaoxing cooking wine",
            "1-1.5 tbsp sugar, to taste",
            "1 tsp salt, to taste",
            "1-1.5 cups water"
          ]
        },
        {
          "group": "Garnish (optional)",
          "items": [
            "Fresh mint sprigs",
            "Edible purple or blue flowers"
          ]
        }
      ],
      "steps": [
        {
          "title": "Prepare the aromatics",
          "lines": [
            "Heat the oil in a wok over medium heat.",
            "Add the ginger, garlic, spring onion whites, star anise and 1 tsp tomato paste.",
            "Saute 1 to 2 minutes until fragrant."
          ]
        },
        {
          "title": "Add the tomatoes",
          "lines": [
            "Add the tomatoes and the rest of the spring onions.",
            "Stir-fry 1 to 2 minutes until soft and juicy."
          ]
        },
        {
          "title": "Season the sauce",
          "lines": [
            "Add the soy sauce, remaining tomato paste, cooking wine, salt and sugar.",
            "Stir until everything dissolves."
          ]
        },
        {
          "title": "Add the fish",
          "lines": [
            "Lay the whole mackerel into the sauce."
          ]
        },
        {
          "title": "Pour in water and braise",
          "lines": [
            "Add water until it comes halfway up the fish.",
            "Bring to a gentle boil, then cover.",
            "Lower the heat and simmer 10 to 12 minutes."
          ]
        },
        {
          "title": "Finish and reduce",
          "lines": [
            "Uncover and spoon the sauce over the fish.",
            "Simmer 3 to 5 minutes until thick."
          ]
        },
        {
          "title": "Plate and serve",
          "lines": [
            "Move the fish to a platter.",
            "Spoon the sauce over the top.",
            "Garnish with mint and flowers. Serve with rice."
          ]
        }
      ],
      "category": "Dinner",
      "yield": "Serves 2",
      "qrLabel": "Original video",
      "short": "Braised Mackerel",
      "description": "Whole mackerel braised in a sweet and tangy tomato sauce with ginger, garlic and star anise. Watch the video, then follow the cards."
    },
    {
      "title": "Greek Chicken Gyros",
      "short": "Chicken Gyros",
      "category": "Dinner",
      "yield": "Serves 5-6",
      "prep": "20 min + overnight marinade",
      "cook": "10 min",
      "credit": "RecipeTin Eats  \u00b7  Photo: Midjourney",
      "source": "https://www.recipetineats.com/kalimeras-famous-chicken-gyros/",
      "qr": "pkg:/images/mychannel/qr_recipe_4.png",
      "qrLabel": "Full recipe",
      "video": "",
      "thumb": "pkg:/images/mychannel/recipe_gyros.jpg",
      "description": "Juicy marinated chicken wrapped in warm pita with a creamy sauce, salad and chips. The secret is a little curry powder in the marinade.",
      "ingredients": [
        {
          "group": "Chicken",
          "items": [
            "1.25 kg (2.5 lb) boneless, skinless chicken thighs",
            "1/3 cup extra virgin olive oil"
          ]
        },
        {
          "group": "Marinade spices",
          "items": [
            "1 tbsp sweet paprika",
            "1 tbsp mustard powder",
            "1 tbsp dried oregano",
            "1/2 tbsp mild curry powder",
            "1 1/2 tsp kosher salt",
            "1/2 tsp black pepper"
          ]
        },
        {
          "group": "Gyros sauce",
          "items": [
            "1 cup Greek yogurt",
